  <XDFTABLE uniqueid="0x0" flags="0x0">
    <description>BMWext_lam_MinCptPronInit_Ca</description>
    <title>Minimum lambda component protection in Init; vector element 0 = pre-turbo, 1 = pre-catalyst, 2 = in-catalyst</title>
    <CATEGORYMEM index="0" category="10" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA />
      <units>-</units>
      <indexcount>3</indexcount>
      <decimalpl>0</decimalpl>
      <outputtype>4</outputtype>
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="Vor ATL" />
      <LABEL index="1" value="Vor kat" />
      <LABEL index="2" value="In kat" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA />
      <units />
      <indexcount>1</indexcount>
      <decimalpl>0</decimalpl>
    </XDFAXIS>
    <XDFAXIS id="z" uniqueid="0x0">
      <EMBEDDEDDATA mmedtypeflags="0x06" mmedaddress="0x719EFE" mmedelementsizebits="16" mmedrowcount="1" mmedcolcount="3" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>AFR</units>
      <decimalpl>3</decimalpl>
      <min>0</min>
      <max>15.999755859375</max>
      <MATH equation="X/4096 * 14.7">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
  </XDFTABLE>
